{
  "version": 6,
  "configurePresets": [
    {
      "name": "x86",
      "displayName": "x86 / Win32 (WOW64 target)",
      "description": "32-bit build using the Visual Studio generator and vcpkg (static CRT)",
      "binaryDir": "${sourceDir}/build/x86",
      "architecture": { "value": "Win32", "strategy": "set" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "x86-debug",   "configurePreset": "x86", "configuration": "Debug" },
    { "name": "x86-release", "configurePreset": "x86", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "x86-debug",
      "configurePreset": "x86",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x86-release",
      "configurePreset": "x86",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
